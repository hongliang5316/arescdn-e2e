# 测试环境配置. setup.sh 会复制成 lab.env 并填上域名组 ID; lab.env 不提交.
# 下面的值对应 192.168.3.x 实验环境, 换环境时按实际修改.

# 请求发往的边缘层节点 IP
EDGE=192.168.3.67
# 回源层节点 IP: 源站看到的回源请求应来自这里
ORIGIN_LAYER_IP=192.168.3.68
# 节点名: 检查 dispatcher 先刷回源层再刷边缘层
EDGE_NODE=lab01
ORIGIN_NODE=lab02
# 测试域名组绑定的节点组
MLNPLOY=mlnploy-w57blmzw

# 测试源站: 在本机以 host 网络运行, 节点通过这个 IP 访问; 8081 是主源站, 8082 模拟内网第三方地址
ORIGIN_IP=192.168.3.69

# 测试域名. SHARE_HOST 的共享缓存域名(as_domain)为 HOST
HOST=test.a.qq.com
SHARE_HOST=share.a.qq.com
# 域名组 ID, 由 setup.sh 创建或查找后填写
DG=
SHARE_DG=

# 控制面: docker compose 目录(读 .env 里的密码)、API 地址、dispatcher 日志目录
ARESTECH_DIR=/opt/arestech
API_ADDR=http://127.0.0.1:18080
DISPATCHER_LOG_DIR=/data/log/arescdn-dispatcher
